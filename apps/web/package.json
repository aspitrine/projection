{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "serve": "vp preview",
    "dev": "vp dev",
    "check-types": "bun run i18n:compile && tsc --noEmit",
    "env:generate": "varlock codegen",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --output-structure locale-modules --emit-ts-declarations --silent",
    "test:e2e": "playwright test",
    "e2e:serve": "vp build && varlock run -- sh -c 'DATABASE_URL=\"$TEST_DATABASE_URL\" BETTER_AUTH_URL=http://localhost:3101 PORT=3101 node .output/server/index.mjs'"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@projection/bible": "workspace:*",
    "@projection/identity": "workspace:*",
    "@projection/live": "workspace:*",
    "@projection/outputs": "workspace:*",
    "@projection/platform": "workspace:*",
    "@projection/presentation": "workspace:*",
    "@projection/projects": "workspace:*",
    "@projection/shared-kernel": "workspace:*",
    "@projection/slides": "workspace:*",
    "@projection/songs": "workspace:*",
    "@projection/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@varlock/vite-integration": "1.5.1",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "nitro": "3.0.260903-beta",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "^0.27.0",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.2",
    "@playwright/test": "1.63.0",
    "@projection/config": "workspace:*",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "web-vitals": "^6.2.1"
  }
}
